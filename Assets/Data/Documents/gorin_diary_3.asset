  id: gorin_diary_3
  title: "\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u0413\u043E\u0440\u0438\u043D\u0430.
    \u0417\u0430\u043F\u0438\u0441\u044C III"
  body: "[\u0434\u0430\u0442\u0430 \u043D\u0435\u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u0430]
    \u0430\u043F\u0440\u0435\u043B\u044C 1987\n\n\u041E\u043D\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F.\n\n\u0414-03,
    \u0414-04, \u0414-05. \u041F\u043E\u0441\u043B\u0435 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043C\u0438\u043D\u0443\u0442\u043D\u043E\u0433\u043E
    \u0441\u0435\u0430\u043D\u0441\u0430 \u2014\n\u043A\u043E\u043C\u0430. \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
    \u0442\u0435\u043B\u0430 28 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432.
    \u0421\u0435\u0440\u0434\u0446\u0435 \u0431\u044C\u0451\u0442\u0441\u044F \u2014\n\u0440\u0430\u0437
    \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u041D\u043E \u043E\u043D\u0438
    \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F.\n\n\u041F\u043E \u043D\u043E\u0447\u0430\u043C
    \u0441\u043B\u044B\u0448\u043D\u043E \u043A\u0430\u043A \u043E\u043D\u0438 \u0445\u043E\u0434\u044F\u0442
    \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443 \u0411.\n\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0443\u0436\u0435 \u0442\u0440\u0438 \u0434\u043D\u044F \u043A\u0430\u043A \u043D\u0435
    \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F.\n\u0412\u043E\u0440\u043E\u043D\u043E\u0432\u0430
    \u0443\u0448\u043B\u0430 \u0438\u0441\u043A\u0430\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
    \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C.\n\n\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
    \u043F\u0443\u043B\u044C\u0441\u0438\u0440\u0443\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435.
    \u0413\u043E\u0440\u0430\u0437\u0434\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435.\n\n\u0415\u0441\u043B\u0438
    \u043A\u0442\u043E-\u0442\u043E \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0442
    \u2014 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u043D\u0435\u0433\u043E\n\u0434\u043E\u043B\u044C\u0448\u0435
    \u0447\u0435\u043C \u043D\u0443\u0436\u043D\u043E. \u0418 \u043D\u0435 \u0441\u043B\u0443\u0448\u0430\u0439
    \u0442\u0438\u0448\u0438\u043D\u0443.\n\n\u0422\u0438\u0448\u0438\u043D\u0430
    \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442.\n\n        \u2014 \u0413\u043E\u0440\u0438\u043D"
