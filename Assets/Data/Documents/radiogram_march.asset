  id: radiogram_march
  title: "\u0420\u0430\u0434\u0438\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u0438\u0437
    \u0426\u0435\u043D\u0442\u0440\u0430. \u041C\u0430\u0440\u0442 1987"
  body: "\u0428\u0418\u0424\u0420\u041E\u0413\u0420\u0410\u041C\u041C\u0410 \u211603-44\n\u041A\u041E\u041C\u0423:  
    \u041E\u0411. \u041A\u0420\u0418\u0421\u0422\u0410\u041B\u041B / \u0413\u041E\u0420\u0418\u041D
    \u0414.\u0412.\n\u041E\u0422:     \u0423\u0421\u0418 \u041C\u041E \u0421\u0421\u0421\u0420\n\u0414\u0410\u0422\u0410:  
    17.03.1987\n\n\u0413\u041E\u0420\u0418\u041D \u2014 \u0420\u0415\u0417\u0423\u041B\u042C\u0422\u0410\u0422\u042B
    \u041F\u0415\u0420\u0412\u041E\u0413\u041E \u041A\u0412\u0410\u0420\u0422\u0410\u041B\u0410\n\u041D\u0415\u0423\u0414\u041E\u0412\u041B\u0415\u0422\u0412\u041E\u0420\u0418\u0422\u0415\u041B\u042C\u041D\u042B
    \u0422\u041E\u0427\u041A\u0410 \u0422\u0415\u041C\u041F\u042B \u0420\u041E\u0421\u0422\u0410\n\u041A\u0420\u0418\u0421\u0422\u0410\u041B\u041B\u0418\u0427\u0415\u0421\u041A\u041E\u0419
    \u0421\u0422\u0420\u0423\u041A\u0422\u0423\u0420\u042B \u041D\u0418\u0416\u0415
    \u0420\u0410\u0421\u0427\u0401\u0422\u041D\u042B\u0425\n\u041D\u0410 40% \u0422\u041E\u0427\u041A\u0410\n\n\u0422\u0420\u0415\u0411\u0423\u0415\u041C
    \u0423\u0412\u0415\u041B\u0418\u0427\u0418\u0422\u042C \u0427\u0418\u0421\u041B\u041E
    \u041A\u041E\u041D\u0422\u0410\u041A\u0422\u041D\u042B\u0425\n\u042D\u041A\u0421\u041F\u0415\u0420\u0418\u041C\u0415\u041D\u0422\u041E\u0412
    \u0422\u041E\u0427\u041A\u0410 \u0420\u0415\u0421\u0423\u0420\u0421 \u041E\u0411\u042A\u0415\u041A\u0422\u041E\u0412\n\u0421\u0415\u0420\u0418\u0418
    \u0414 \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u0422\u042C
    \u041F\u041E\u041B\u041D\u041E\u0421\u0422\u042C\u042E \u0422\u041E\u0427\u041A\u0410\n\n\u0421\u041B\u0415\u0414\u0423\u042E\u0429\u0418\u0419
    \u041E\u0422\u0427\u0401\u0422 \u2014 \u041D\u0415 \u041F\u041E\u0417\u0414\u041D\u0415\u0415
    01.05.87\n\u0422\u041E\u0427\u041A\u0410 \u041F\u0420\u041E\u0412\u0410\u041B\u0410
    \u041D\u0415 \u0414\u041E\u041F\u0423\u0421\u0422\u0418\u041C \u0422\u041E\u0427\u041A\u0410\n\n\u0423\u0421\u0418
    / \u0426\u0415\u041D\u0422\u0420"
