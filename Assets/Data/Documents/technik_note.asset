  id: technik_note
  title: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0436\u0443\u0440\u043D\u0430\u043B
    \u0442\u0435\u0445\u043D\u0438\u043A\u0430"
  body: "\u0416\u0423\u0420\u041D\u0410\u041B \u0422\u0415\u0425\u041E\u0411\u0421\u041B\u0423\u0416\u0418\u0412\u0410\u041D\u0418\u042F\n\u041E\u0431\u044A\u0435\u043A\u0442
    \xAB\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\xBB, \u0434\u0438\u0437\u0435\u043B\u044C\u043D\u0430\u044F\n\n14.04.87
    \u2014 \u043F\u043B\u0430\u043D\u043E\u0432\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430.
    \u041D\u043E\u0440\u043C\u0430.\n\n17.04.87 \u2014 \u0441\u043A\u0430\u0447\u043E\u043A
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u0432 \u0431\u043B\u043E\u043A\u0435
    \u0411.\n          \u041F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0438
    \u0432\u044B\u0431\u0438\u0442\u044B \u043D\u0430 \u0449\u0438\u0442\u043A\u0435
    \u21162.\n          \u0417\u0430\u043C\u0435\u043D\u0438\u043B. \u041F\u0440\u0438\u0447\u0438\u043D\u0430
    \u043D\u0435\u044F\u0441\u043D\u0430.\n\n19.04.87 \u2014 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0433\u043B\u043E\u0445\u043D\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0435
    \u0434\u0432\u0430 \u0447\u0430\u0441\u0430.\n          \u0413\u043E\u0440\u0438\u043D
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F.\n          \u041B\u0435\u0433\u043A\u043E
    \u0435\u043C\u0443 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.\n\n21.04.87
    \u2014 \u043D\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u0441\u043E\u0432\u0441\u0435\u043C. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\n         
    \u0442\u043E\u043F\u043B\u0438\u0432\u043E \u2014 \u043F\u043E\u043B\u043D\u044B\u0439
    \u0431\u0430\u043A. \u0421\u0432\u0435\u0447\u0438 \u2014 \u043D\u043E\u0432\u044B\u0435.\n         
    \u0422\u0430\u043A\u043E\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435
    \u0447\u0442\u043E \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E\n         
    \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C.\n\n         
    \u041D\u043E\u0447\u044C\u044E \u0432 \u0431\u043B\u043E\u043A\u0435 \u0411 \u0431\u044B\u043B
    \u0448\u0443\u043C.\n          \u041E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
    \u0448\u0443\u043C.\n\n[\u0437\u0430\u043F\u0438\u0441\u0438 \u043E\u0431\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F]"
