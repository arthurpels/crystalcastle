  id: gorin_diary_1
  title: "\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u0413\u043E\u0440\u0438\u043D\u0430.
    \u0417\u0430\u043F\u0438\u0441\u044C I"
  body: "3 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F 1986\n\n\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
    \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C. \u0422\u0440\u0438 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0438,
    \u043F\u043E\u0442\u043E\u043C \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442.\n\u0427\u0443\u043A\u043E\u0442\u043A\u0430
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430 \u0442\u0443\u043C\u0430\u043D\u043E\u043C
    \u0438 \u0442\u0438\u0448\u0438\u043D\u043E\u0439 \u0442\u0430\u043A\u043E\u0439,
    \u0447\u0442\u043E \u0443\u0448\u0438\n\u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442.
    \u041E\u0431\u044A\u0435\u043A\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u2014 \u0448\u0435\u0441\u0442\u044C \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0439,\n\u0436\u0438\u043B\u043E\u0439
    \u0431\u043B\u043E\u043A, \u0434\u0438\u0437\u0435\u043B\u044C\u043D\u0430\u044F.
    \u041F\u0435\u0440\u0441\u043E\u043D\u0430\u043B \u2014 \u0432\u043E\u0441\u0435\u043C\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A.\n\n\u041E\u0431\u0440\u0430\u0437\u0435\u0446
    \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0435\u0449\u0451 \u0434\u043E
    \u043D\u0430\u0441. \u041E\u043D \u043B\u0435\u0436\u0438\u0442 \u0432 \u0431\u043E\u043A\u0441\u0435
    \u0411-3,\n\u0432 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0435.
    \u041A\u043E\u0433\u0434\u0430 \u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
    \u0435\u0433\u043E \u0443\u0432\u0438\u0434\u0435\u043B \u2014 \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u043B.\n\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
    \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u0441 \u043A\u0443\u043B\u0430\u043A,
    \u043D\u043E \u0441\u0432\u0435\u0442 \u0432 \u043D\u0451\u043C \u0436\u0438\u0432\u0451\u0442
    \u043A\u0430\u043A\n\u0431\u0443\u0434\u0442\u043E \u0441\u0430\u043C \u043F\u043E
    \u0441\u0435\u0431\u0435. \u041F\u0443\u043B\u044C\u0441\u0438\u0440\u0443\u0435\u0442.
    \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0440\u043E\u0432\u043D\u043E.\n\u041A\u0430\u043A
    \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043D\u0438\u0435.\n\n\u0412\u043E\u0440\u043E\u043D\u043E\u0432\u0430
    \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u2014 \u0436\u0443\u0442\u044C. \u042F
    \u0437\u0430\u0441\u043C\u0435\u044F\u043B\u0441\u044F.\n\u0421\u0435\u0439\u0447\u0430\u0441
    \u0443\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A \u0441\u043C\u0435\u0448\u043D\u043E."
  type: 2
  groupId: gorin_diary
