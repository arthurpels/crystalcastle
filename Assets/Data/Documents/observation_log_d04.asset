  id: observation_log_d04
  title: "\u0416\u0443\u0440\u043D\u0430\u043B \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439.
    \u041E\u0431\u044A\u0435\u043A\u0442 \u0414-04"
  body: "\u0416\u0423\u0420\u041D\u0410\u041B \u041A\u041B\u0418\u041D\u0418\u0427\u0415\u0421\u041A\u041E\u0413\u041E
    \u041D\u0410\u0411\u041B\u042E\u0414\u0415\u041D\u0418\u042F\n\u041E\u0431\u044A\u0435\u043A\u0442:
    \u0414-04 (\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432 \u041F.\u0421., 1951
    \u0433.\u0440.)\n\u0412\u0435\u0434\u0443\u0449\u0438\u0439: \u0413\u043E\u0440\u0438\u043D
    \u0414.\u0412.\n\n\u0421\u0415\u0410\u041D\u0421 1 (14.01.87, 5 \u043C\u0438\u043D.)\n 
    t \u0442\u0435\u043B\u0430: 35.8\xB0C \u2192 34.1\xB0C\n  \u0427\u0421\u0421:
    72 \u2192 58 \u0443\u0434/\u043C\u0438\u043D\n  \u0420\u0435\u0430\u043A\u0446\u0438\u0438:
    \u0441\u043B\u0430\u0431\u0430\u044F \u0437\u0430\u0442\u043E\u0440\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C.\n 
    \u041E\u0431\u044A\u0435\u043A\u0442 \u0432 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438.\n\n\u0421\u0415\u0410\u041D\u0421
    4 (28.01.87, 20 \u043C\u0438\u043D.)\n  t \u0442\u0435\u043B\u0430: 32.4\xB0C\n 
    \u0427\u0421\u0421: 28 \u0443\u0434/\u043C\u0438\u043D\n  \u041E\u0431\u044A\u0435\u043A\u0442
    \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u043D\u0430
    \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435.\n  \u0417\u0440\u0430\u0447\u043A\u0438
    \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u044B. \u0412\u0437\u0433\u043B\u044F\u0434
    \u2014 \u043D\u0430 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B.\n\n\u0421\u0415\u0410\u041D\u0421
    6 (11.02.87, 30 \u043C\u0438\u043D.)\n  t \u0442\u0435\u043B\u0430: 28.9\xB0C\n 
    \u0427\u0421\u0421: 11 \u0443\u0434/\u043C\u0438\u043D\n  \u041E\u0431\u044A\u0435\u043A\u0442
    \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u043D\u0430
    \u0431\u043E\u043B\u0435\u0432\u044B\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043B\u0438.\n 
    \u0414\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F. \u0421\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.\n 
    \u041F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435.\n\n\u041F\u0420\u0418\u041C\u0415\u0427\u0410\u041D\u0418\u0415:
    \u041E\u0431\u044A\u0435\u043A\u0442 \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D
    \u0432 \u0431\u043E\u043A\u0441\u0435 \u0411-7.\n\u041A\u043B\u044E\u0447\u0438
    \u0443 \u0413\u043E\u0440\u0438\u043D\u0430."
