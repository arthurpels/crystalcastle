  id: voronova_note
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430. \u041F\u043E\u0447\u0435\u0440\u043A
    \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439"
  body: "\u0414\u0438\u043C\u0430,\n\n\u044F \u0437\u0430\u043F\u0435\u0440\u043B\u0430\u0441\u044C
    \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 4. \u0414\u0432\u0435\u0440\u044C
    \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F.\n\u0421\u043B\u044B\u0448\u0443
    \u0438\u0445 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435 \u2014 \u043E\u043D\u0438
    \u0445\u043E\u0434\u044F\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,\n\u043D\u043E
    \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F.\n\n\u042F
    \u043D\u0430\u0448\u043B\u0430 \u0442\u0432\u043E\u0438 \u0437\u0430\u043F\u0438\u0441\u0438
    \u043F\u0440\u043E \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B.\n\u041F\u0440\u043E
    \u0442\u043E \u0447\u0442\u043E \u043E\u043D \xAB\u0440\u0435\u0437\u043E\u043D\u0438\u0440\u0443\u0435\u0442
    \u0441 \u043D\u0435\u0440\u0432\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439\xBB.\n\u041F\u0440\u043E
    \u0442\u043E \u0447\u0442\u043E \xAB\u043F\u0440\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438\n\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F\xBB.\n\n\u041F\u043E\u0447\u0435\u043C\u0443
    \u0442\u044B \u043C\u043D\u0435 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B?\n\n\u0423
    \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0444\u043E\u043D\u0430\u0440\u0438\u043A
    \u0438 \u0442\u0440\u0438 \u0431\u0430\u043D\u043A\u0438 \u0442\u0443\u0448\u0451\u043D\u043A\u0438.\n\u0415\u0441\u043B\u0438
    \u043F\u0440\u0438\u0434\u0443\u0442 \u0437\u0430 \u043C\u043D\u043E\u0439 \u2014
    \u044F \u043D\u0435 \u043E\u0442\u043A\u0440\u043E\u044E.\n\n\u0415\u0441\u043B\u0438
    \u0442\u044B \u0436\u0438\u0432 \u2014 \u043E\u0441\u0442\u0430\u0432\u044C \u0437\u043D\u0430\u043A
    \u0443 \u0434\u0432\u0435\u0440\u0438 \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439.\n\n       
    \u0410\u043D\u044F"
