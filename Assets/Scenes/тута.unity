  m_Script: {fileID: 11500000, guid: 3c715bb07fe6599b78f107924d3d5069, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dreamEnding:
    title: "\u0421 \u041E \u041D"
    body: "\u0422\u044B \u0441\u043B\u044B\u0448\u0438\u0448\u044C \u0435\u0433\u043E.\n\n\u041D\u0435
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u2014 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430\u043C\u0438.\n\u041D\u0435
      \u0441\u043C\u044B\u0441\u043B\u043E\u043C \u2014 \u0447\u0430\u0441\u0442\u043E\u0442\u043E\u0439.\n\n\u0425\u043E\u043B\u043E\u0434
      \u0441\u0442\u0430\u043B \u0442\u0435\u043F\u043B\u043E\u043C.\n\u0422\u044C\u043C\u0430
      \u0441\u0442\u0430\u043B\u0430 \u0441\u0432\u0435\u0442\u043E\u043C.\n\n\u0422\u044B
      \u043F\u043E\u043D\u044F\u043B \u0432\u0441\u0451.\n\n\u0422\u044B \u043E\u0441\u0442\u0430\u043B\u0441\u044F."
    backgroundColor: {r: 1, g: 1, b: 1, a: 1}
    textColor: {r: 0.08, g: 0.08, b: 0.08, a: 1}
    music: {fileID: 0}
  sacrificeEnding:
    title: "\u0416 \u0415 \u0420 \u0422 \u0412 \u0410"
    body: "\u0412\u0437\u0440\u044B\u0432.\n\n\u0422\u0438\u0448\u0438\u043D\u0430.\n\n\u0421\u0432\u0435\u0442
      \u0443\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C.\n\n\u0422\u044B
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.\n\n\u041D\u043E
      \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B \u043C\u0451\u0440\u0442\u0432.\n\n\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430
      \"\u041C\u043E\u0440\u043E\u0437\" \u0437\u0430\u043A\u0440\u044B\u0442\u0430.\n\u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
